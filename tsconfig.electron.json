{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],

    "rootDir": ".",
    "outDir": "electron-build",
    "noEmitOnError": true,
    "sourceMap": false,
    "declaration": false,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["electron/**/*.cts", "scripts/**/*.mts"],
  "exclude": ["node_modules", "electron-build", "dist", "release"]
}
