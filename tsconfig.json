{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "noEmit": true,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": false,
    "noUnusedParameters": true,
    "noUnusedLocals": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": false,
    "checkJs": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,

    "types": []
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
